      "id": "agents_project_identity",
      "label": "Portfolio Project Identity",
      "file_type": "concept",
      "source_file": "AGENTS.md",
      "source_location": "Section 1",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The site must feel like a premium digital experience with visual storytelling, editorial composition, deliberate motion and high-quality interaction design - not a conventional resume or generic developer portfolio."
    },
    {
      "id": "agents_mimo_reference",
