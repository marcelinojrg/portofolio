    {
      "id": "agents_documentation_hierarchy",
      "label": "Documentation Hierarchy",
      "file_type": "concept",
      "source_file": "AGENTS.md",
      "source_location": "Section 4",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Decision priority order AGENTS > VISION > DESIGN > ANIMATION > ARCHITECTURE > COMPONENTS > CONTENT; on conflict the more specific rule must not contradict the project vision."
    },
    {
      "id": "agents_design_principles",
      "label": "Design Principles",
      "file_type": "rationale",
      "source_file": "AGENTS.md",
      "source_location": "Section 5",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Premium, modern, editorial, minimal but expressive, typography-led, motion-aware; explicitly avoids generated-template trends (glassmorphism, random gradients, SaaS aesthetics, generic AI layouts)."
    },
    {
      "id": "agents_content_principles",
      "label": "Content Principles",
      "file_type": "rationale",
      "source_file": "AGENTS.md",
      "source_location": "Section 6",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Content must be concise, specific and believable; never invent employers, metrics, awards, testimonials or outcomes; projects presented as case studies, not cards."
    },
    {
      "id": "agents_animation_principles",
      "label": "Animation Principles",
      "file_type": "rationale",
      "source_file": "AGENTS.md",
      "source_location": "Section 7",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Animation is product experience, not decoration; every animation needs intentional purpose; prefer transform/opacity, avoid layout-heavy properties during scroll."
    },
    {
      "id": "agents_performance_rules",
      "label": "Performance Rules",
      "file_type": "rationale",
      "source_file": "AGENTS.md",
      "source_location": "Section 8",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Site must stay fast despite rich motion: static Astro rendering, minimal client JS, islands only where necessary, lazy loading, no long-running timers on hidden pages."
    },
    {
      "id": "agents_accessibility_rules",
      "label": "Accessibility Rules",
      "file_type": "rationale",
      "source_file": "AGENTS.md",
      "source_location": "Section 9",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Keyboard navigation, screen readers, focus states, contrast and reduced-motion support are required; animation must never block access to content."
    },
    {
      "id": "agents_responsive_rules",
      "label": "Responsive Rules",
      "file_type": "rationale",
      "source_file": "AGENTS.md",
      "source_location": "Section 10",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Mobile-first; mobile is not a shrunk desktop layout - it gets simplified choreography, reduced parallax and alternate composition."
    },
    {
