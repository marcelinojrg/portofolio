---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Hero from '../components/home/Hero.astro';
import SectionIntro from '../components/home/SectionIntro.astro';
import ProjectIndex from '../components/home/ProjectIndex.astro';
import AboutIntro from '../components/home/AboutIntro.astro';
import Capabilities from '../components/home/Capabilities.astro';
import ContactCTA from '../components/home/ContactCTA.astro';
---

<BaseLayout
  title="Marcelino Jorgi - Creative Technologist"
  description="Portfolio of Marcelino Jorgi, Information Systems student and creative technologist building digital experiences."
>
  <SiteHeader />
  <main id="main">
    <Hero />
    <SectionIntro />
    <ProjectIndex />
    <AboutIntro />
    <Capabilities />
    <ContactCTA />
  </main>
  <SiteFooter />
</BaseLayout>
