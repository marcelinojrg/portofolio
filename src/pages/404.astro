---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found - Marcelino Jorgi"
  description="The page you are looking for does not exist."
>
  <main
    id="main"
    class="flex min-h-[100svh] flex-col items-center justify-center gap-6 px-6 text-center"
  >
    <p class="font-display text-text-muted text-sm tracking-[0.2em] uppercase">
      404
    </p>
    <h1 class="font-display text-4xl font-medium tracking-tight md:text-6xl">
      This page doesn&rsquo;t exist.
    </h1>
    <p class="text-text-muted max-w-md">
      The link may be broken, or the page may have moved.
    </p>
    <a
      href="/"
      class="border-text font-display inline-flex items-center gap-2 border-b pb-1 text-sm font-medium tracking-wide"
    >
      Back home
    </a>
  </main>
</BaseLayout>
