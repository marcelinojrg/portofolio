---
import './Intro.css';
---

<!-- Kinetic intro curtain. Rendered once in BaseLayout; gated by html.js
     + full motion in CSS, animated + removed by lib/animations/intro.ts.
     Clicking anywhere skips the sequence. -->
<div class="site-intro" data-intro aria-hidden="true">
  <p class="site-intro__title" aria-hidden="true">
    <span class="site-intro__mask"
      ><span class="site-intro__word" data-intro-word>Marcelino</span></span
    >
    <span class="site-intro__mask"
      ><span class="site-intro__word" data-intro-word>Jorgi</span></span
    >
  </p>
  <p class="site-intro__count" data-intro-count aria-hidden="true">00</p>
  <span class="site-intro__bar" data-intro-bar aria-hidden="true"></span>
</div>
