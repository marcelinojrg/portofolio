---
import './SectionIntro.css';
---

<section class="section-intro">
  <span class="section-intro-watermark" aria-hidden="true">Approach</span>
  <h2 class="section-intro__title" data-lines>
    <span>Structure, then craft.</span>
    <span class="section-intro__accent">Then ship it.</span>
  </h2>
  <span class="section-intro-rule" data-rule-draw aria-hidden="true"></span>
  <p class="section-intro__lede" data-reveal data-word-scrub>
    Good products emerge from understanding systems and people equally - not
    from adding features.
  </p>
</section>

<script>
  const rule = document.querySelector('[data-rule-draw]');
  if (rule) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      rule.classList.add('is-drawn');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              rule.classList.add('is-drawn');
              io.disconnect();
            }
          });
        },
        { threshold: 0.6 },
      );
      io.observe(rule);
    }
  }
</script>
