---
import { site } from '@/lib/constants/site';
import './Hero.css';
import '../shared/marquee.css';
---

<section class="hero">
  <div class="hero__inner" data-hero-scene>
    <div class="hero__meta" data-hero>
      <p class="eyebrow">{site.name} - {site.role}</p>
      <span class="hero__rule"></span>
    </div>

    <h1 class="hero-title" data-hero-title>
      <span class="hero-title__line">
        <span class="hero-title__word hero-greeting" data-hero-word
          >Hello <span class="hero-emoji" data-hero-emoji aria-hidden="true"
            >👋</span
          ></span
        >
      </span>
      <span class="hero-title__line">
        <span class="hero-title__word hero-name" data-hero-word
          >I'm <span class="hero-rotate hero-accent" data-hero-rotate
          ></span></span
        >
      </span>
    </h1>

    <p class="hero-note" data-hero>
      Idk what kind of website I'm building here.
    </p>

    <div class="hero__footer" data-hero>
      <p class="hero__blurb">
        Information Systems student building digital products - blending systems
        thinking, code, and visual design.
      </p>
      <div class="hero__actions">
        <div class="hero__scroll-wrap">
          <span class="hero-scroll-hint">
            <span class="eyebrow">Scroll</span>
            <span class="hero-scroll-hint__line" data-hero-scroll-line></span>
          </span>
        </div>
        <a href="/#work" class="hero__cta" data-magnetic>
          View selected work
          <span class="hero__cta-arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <div class="hero-marquee" data-marquee aria-hidden="true">
    <div class="marquee-track" data-marquee-track>
      <div class="marquee-group">
        {
          Array.from({ length: 3 }).flatMap(() => [
            <span class="marquee-item">Creative Technologist</span>,
            <span class="marquee-star">&#10022;</span>,
            <span class="marquee-item">Information Systems</span>,
            <span class="marquee-star">&#10022;</span>,
            <span class="marquee-item">Design &amp; Code</span>,
            <span class="marquee-star">&#10022;</span>,
          ])
        }
      </div>
      <div class="marquee-group" aria-hidden="true">
        {
          Array.from({ length: 3 }).flatMap(() => [
            <span class="marquee-item">Creative Technologist</span>,
            <span class="marquee-star">&#10022;</span>,
            <span class="marquee-item">Information Systems</span>,
            <span class="marquee-star">&#10022;</span>,
            <span class="marquee-item">Design &amp; Code</span>,
            <span class="marquee-star">&#10022;</span>,
          ])
        }
      </div>
    </div>
  </div>
</section>

<script>
  type TimedEl = HTMLElement & {
    _timer?: ReturnType<typeof setInterval> | null;
  };

  // Every interval/timeout the hero creates is tracked so it can be torn down
  // on view-transition swaps. Without this, timers keep mutating a detached
  // DOM tree after navigating away — and stack up on every visit home.
  const intervals = new Set<ReturnType<typeof setInterval>>();
  const timeouts = new Set<ReturnType<typeof setTimeout>>();

  function trackInterval(fn: () => void, ms: number) {
    const id = setInterval(fn, ms);
    intervals.add(id);
    return id;
  }

  function untrackInterval(id: ReturnType<typeof setInterval>) {
    clearInterval(id);
    intervals.delete(id);
  }

  function trackTimeout(fn: () => void, ms: number) {
    const id = setTimeout(() => {
      timeouts.delete(id);
      fn();
    }, ms);
    timeouts.add(id);
    return id;
  }

  function clearTrackedTimers() {
    for (const id of intervals) clearInterval(id);
    for (const id of timeouts) clearTimeout(id);
    intervals.clear();
    timeouts.clear();
  }

  document.addEventListener('astro:before-swap', clearTrackedTimers);

  function initHeroEmoji() {
    const el = document.querySelector<HTMLElement>('[data-hero-emoji]');
    if (!el || el.dataset.emojiReady) return;
    el.dataset.emojiReady = 'true';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const emojis = ['👋', '✨', '🚀'];
    let i = 0;
    trackInterval(() => {
      i = (i + 1) % emojis.length;
      el.style.opacity = '0';
      trackTimeout(() => {
        el.textContent = emojis[i];
        el.style.opacity = '0';
        el.style.transform = 'translateY(0.4em)';
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
          }),
        );
      }, 420);
    }, 5000);
  }
  document.addEventListener('astro:page-load', initHeroEmoji);

  function initHeroRotate() {
    const el = document.querySelector<HTMLElement>('[data-hero-rotate]');
    if (!el || el.dataset.rotateReady) return;
    el.dataset.rotateReady = 'true';

    const words = ['Marcelino Jorgi', 'a Developer', 'a Designer', 'a Student'];
    const maxLen = Math.max(...words.map((w) => w.length));
    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz#%&*/';
    const toChars = (t: string) => [...t];

    for (let i = 0; i < maxLen; i++) {
      const s = document.createElement('span');
      s.className = 'ch';
      s.setAttribute('aria-hidden', 'true');
      el.appendChild(s);
    }
    const spans = Array.from(el.children) as TimedEl[];

    const clearAll = () =>
      spans.forEach((s) => {
        if (s._timer) {
          untrackInterval(s._timer);
          s._timer = null;
        }
      });

    const setStatic = (span: HTMLElement, c: string) => {
      if (c === '') {
        span.textContent = '';
        span.style.opacity = '0';
      } else if (c === ' ') {
        span.textContent = ' ';
        span.style.opacity = '1';
      } else {
        span.textContent = c;
        span.style.opacity = '1';
      }
    };

    let runId = 0;
    let pending: ReturnType<typeof setTimeout> | null = null;

    const paint = (text: string, animate: boolean, onDone?: () => void) => {
      el.setAttribute('aria-label', text);
      const chars = toChars(text);
      if (!animate) {
        clearAll();
        spans.forEach((span, i) => setStatic(span, chars[i] ?? ''));
        onDone?.();
        return;
      }
      clearAll();
      if (pending) {
        clearTimeout(pending);
        timeouts.delete(pending);
        pending = null;
      }
      const myRun = ++runId;
      let i = 0;
      const step = () => {
        if (myRun !== runId || i >= spans.length) {
          onDone?.();
          return;
        }
        const span = spans[i];
        const c = chars[i] ?? '';
        i++;
        if (c === '' || c === ' ') {
          setStatic(span, c);
          step();
          return;
        }
        span.style.opacity = '1';
        const start = performance.now();
        const duration = 260;
        span._timer = trackInterval(() => {
          if (myRun !== runId) {
            if (span._timer) untrackInterval(span._timer);
            return;
          }
          if (performance.now() - start >= duration) {
            if (span._timer) untrackInterval(span._timer);
            span._timer = null;
            span.textContent = c;
            step();
          } else {
            span.textContent = GLYPHS[(Math.random() * GLYPHS.length) | 0];
          }
        }, 35);
      };
      step();
    };

    if (reduce) {
      paint(words[0], false);
      return;
    }

    paint(words[0], false);
    let idx = 0;
    const cycle = () => {
      idx = (idx + 1) % words.length;
      paint(words[idx], true, () => {
        pending = trackTimeout(cycle, 4000);
      });
    };
    pending = trackTimeout(cycle, 4000);
  }
  document.addEventListener('astro:page-load', initHeroRotate);
</script>
