---
import { site } from '@/lib/constants/site';
import './Hero.css';
import '../shared/marquee.css';
---

<section class="hero">
  <div class="hero__inner" data-hero-scene>
    <div class="hero__meta" data-hero>
      <p class="eyebrow">{site.name} - {site.role}</p>
      <span class="hero__rule"></span>
    </div>

    <h1 class="hero-title" data-hero-title>
      <span class="hero-title__line">
        <span class="hero-title__word hero-greeting" data-hero-word>Hello</span>
      </span>
      <span class="hero-title__line">
        <span class="hero-title__word hero-name" data-hero-word
          >I'm <span
            class="hero-rotate hero-accent"
            data-hero-rotate
            aria-hidden="true">Marcelino Jorgi</span
          ></span
        >
        <!-- Static accessible name for the kinetic rotate effect: the
             animated glyphs above are aria-hidden, screen readers get this. -->
        <span class="visually-hidden">Marcelino Jorgi</span>
      </span>
    </h1>

    <p class="hero-note" data-hero>
      Idk what kind of website I'm building here.
    </p>

    <div class="hero__footer" data-hero>
      <p class="hero__blurb">
        Information Systems student building digital products - blending systems
        thinking, code, and visual design.
      </p>
      <div class="hero__actions">
        <div class="hero__scroll-wrap">
          <span class="hero-scroll-hint">
            <span class="eyebrow">Scroll</span>
            <span class="hero-scroll-hint__line" data-hero-scroll-line></span>
          </span>
        </div>
        <a
          href={`${import.meta.env.BASE_URL}#work`}
          class="hero__cta"
          data-magnetic
        >
          View selected work
          <span class="hero__cta-arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <div class="hero-marquee" data-marquee aria-hidden="true">
    <div class="marquee-track" data-marquee-track>
      <div class="marquee-group">
        {
          Array.from({ length: 3 }).flatMap(() => [
            <span class="marquee-item">Creative Technologist</span>,
            <span class="marquee-star">&#10022;</span>,
            <span class="marquee-item">Information Systems</span>,
            <span class="marquee-star">&#10022;</span>,
            <span class="marquee-item">Design &amp; Code</span>,
            <span class="marquee-star">&#10022;</span>,
          ])
        }
      </div>
      <div class="marquee-group" aria-hidden="true">
        {
          Array.from({ length: 3 }).flatMap(() => [
            <span class="marquee-item">Creative Technologist</span>,
            <span class="marquee-star">&#10022;</span>,
            <span class="marquee-item">Information Systems</span>,
            <span class="marquee-star">&#10022;</span>,
            <span class="marquee-item">Design &amp; Code</span>,
            <span class="marquee-star">&#10022;</span>,
          ])
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Every interval/timeout the hero creates is tracked so it can be torn down
  // on view-transition swaps. Without this, timers keep mutating a detached
  // DOM tree after navigating away — and stack up on every visit home.
  const intervals = new Set<ReturnType<typeof setInterval>>();
  const timeouts = new Set<ReturnType<typeof setTimeout>>();
  let removeMotionPreference: (() => void) | null = null;

  function trackInterval(fn: () => void, ms: number) {
    const id = setInterval(fn, ms);
    intervals.add(id);
    return id;
  }

  function untrackInterval(id: ReturnType<typeof setInterval>) {
    clearInterval(id);
    intervals.delete(id);
  }

  function trackTimeout(fn: () => void, ms: number) {
    const id = setTimeout(() => {
      timeouts.delete(id);
      fn();
    }, ms);
    timeouts.add(id);
    return id;
  }

  function clearTrackedTimers() {
    for (const id of intervals) clearInterval(id);
    for (const id of timeouts) clearTimeout(id);
    intervals.clear();
    timeouts.clear();
  }

  function clearHeroState() {
    clearTrackedTimers();
    removeMotionPreference?.();
    removeMotionPreference = null;
  }

  document.addEventListener('astro:before-swap', clearHeroState);

  function initHeroRotate() {
    const el = document.querySelector<HTMLElement>('[data-hero-rotate]');
    if (!el || el.dataset.rotateReady) return;
    el.dataset.rotateReady = 'true';
    removeMotionPreference?.();

    const words = ['Marcelino Jorgi', 'a Developer', 'a Designer', 'a Student'];
    const motionPreference = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    );
    const onMotionPreferenceChange = () => {
      clearTrackedTimers();
      delete el.dataset.rotateReady;
      initHeroRotate();
    };
    motionPreference.addEventListener('change', onMotionPreferenceChange);
    removeMotionPreference = () =>
      motionPreference.removeEventListener('change', onMotionPreferenceChange);
    const reduce = motionPreference.matches;
    const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz#%&*/';
    let runId = 0;
    let pending: ReturnType<typeof setTimeout> | null = null;
    let activeTimer: ReturnType<typeof setInterval> | null = null;

    const clearActiveTimer = () => {
      if (!activeTimer) return;
      untrackInterval(activeTimer);
      activeTimer = null;
    };

    const paint = (text: string, animate: boolean, onDone?: () => void) => {
      if (pending) {
        clearTimeout(pending);
        timeouts.delete(pending);
        pending = null;
      }
      clearActiveTimer();
      const myRun = ++runId;

      if (!animate) {
        el.textContent = text;
        onDone?.();
        return;
      }

      const chars = [...text];
      const start = performance.now();
      const duration = 260;
      activeTimer = trackInterval(() => {
        if (myRun !== runId) {
          clearActiveTimer();
          return;
        }

        const progress = Math.min(1, (performance.now() - start) / duration);
        const visible = Math.floor(progress * chars.length);
        el.textContent = chars
          .map((char, index) => {
            if (index < visible || char === ' ') return char;
            return GLYPHS[(Math.random() * GLYPHS.length) | 0];
          })
          .join('');

        if (progress >= 1) {
          clearActiveTimer();
          el.textContent = text;
          onDone?.();
        }
      }, 35);
    };

    if (reduce) {
      paint(words[0], false);
      return;
    }

    paint(words[0], false);
    let idx = 0;
    const cycle = () => {
      idx = (idx + 1) % words.length;
      paint(words[idx], true, () => {
        pending = trackTimeout(cycle, 4000);
      });
    };
    pending = trackTimeout(cycle, 4000);
  }
  document.addEventListener('astro:page-load', initHeroRotate);
</script>
