---
import { getCollection } from 'astro:content';
import ProjectCover from '../shared/ProjectCover.astro';
import './ProjectIndex.css';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="project-index">
  <div class="project-index__head">
    <div>
      <p class="eyebrow" data-reveal>Selected work</p>
      <h2 class="project-index__title" data-reveal>
        Selected projects, built to ship.
      </h2>
    </div>
    <p class="project-index__hint" data-reveal>
      Hover a row - the preview follows.
    </p>
  </div>

  <ul class="project-index__list">
    {
      projects.map((p, i) => (
        <li data-reveal>
          <a
            href={`${import.meta.env.BASE_URL}work/${p.id}`}
            class="project-row"
            data-showcase-row={p.id}
          >
            <span class="project-row__num">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="project-row__title">{p.data.title}</span>
            <span class="project-row__meta">
              {p.data.year
                ? `${p.data.year} - ${p.data.category}`
                : p.data.category}
            </span>
            <div class="project-row__cover" aria-hidden="true">
              <ProjectCover project={p} index={i} uid={`row-${p.id}`} />
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="showcase-preview" data-showcase-preview aria-hidden="true">
    {
      projects.map((p, i) => (
        <div
          class="showcase-preview__item"
          data-preview-item={p.id}
          aria-hidden="true"
        >
          <ProjectCover project={p} index={i} uid={`pv-${p.id}`} />
        </div>
      ))
    }
  </div>
</section>
