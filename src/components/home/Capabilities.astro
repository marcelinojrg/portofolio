---
import '../shared/marquee.css';
import './Capabilities.css';

const groups = [
  {
    title: 'Engineering',
    tags: ['TypeScript', 'React', 'Astro', 'SQL', 'Node.js'],
  },
  {
    title: 'Design',
    tags: ['UI/UX', 'Prototyping', 'Design Systems', 'Motion'],
  },
  {
    title: 'Strategy',
    tags: ['Systems Thinking', 'Product', 'Research', 'Technical Writing'],
  },
];

const marqueeWords = [
  'Systems Thinking',
  'TypeScript',
  'Interface Design',
  'React',
  'Motion',
  'Data & SQL',
  'Prototyping',
];
---

<div class="capabilities-marquee" data-marquee aria-hidden="true">
  <div class="marquee-track" data-marquee-track>
    <div class="marquee-group">
      {
        marqueeWords.flatMap((w) => [
          <span class="marquee-item">{w}</span>,
          <span class="marquee-star">&#10022;</span>,
        ])
      }
    </div>
    <div class="marquee-group" aria-hidden="true">
      {
        marqueeWords.flatMap((w) => [
          <span class="marquee-item">{w}</span>,
          <span class="marquee-star">&#10022;</span>,
        ])
      }
    </div>
  </div>
</div>

<section id="experience" class="capabilities">
  <p class="eyebrow capabilities__eyebrow" data-reveal>Capabilities</p>
  <h2 class="capabilities__title" data-reveal>What I bring to the table.</h2>

  <div class="capabilities__grid">
    {
      groups.map((g, i) => (
        <div class="capability" data-reveal data-reveal-delay={String(i * 0.1)}>
          <div class="capability__head">
            <span class="capability__name">/ {g.title}</span>
            <span class="capability__num">
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>
          <ul class="capability__tags">
            {g.tags.map((t) => (
              <li class="capability__tag">{t}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
