---
import { site } from '@/lib/constants/site';
---

<section
  id="contact"
  class="bg-inverse-bg text-inverse-text relative overflow-hidden"
>
  <span class="contact-watermark" aria-hidden="true" data-parallax="48"
    >MJ.</span
  >
  <div class="mx-auto max-w-6xl px-6 py-[var(--spacing-section)] md:px-10">
    <p class="eyebrow text-inverse-muted! mb-8" data-reveal>Contact</p>
    <h2
      class="font-display text-contact leading-[0.98] font-medium tracking-[-0.03em]"
      data-reveal
    >
      Have a project
      <span class="block">in mind?</span>
      <span
        class="font-body text-accent-inverse mt-2 block text-[0.62em] font-semibold tracking-[-0.01em] italic"
      >
        Let&rsquo;s build it.
      </span>
    </h2>
    <a
      href={`mailto:${site.email}`}
      class="group font-display mt-14 inline-flex items-center gap-5 text-2xl font-medium tracking-tight md:text-4xl"
      data-magnetic
      data-reveal
    >
      <span class="contact-mail-underline">{site.email}</span>
      <span class="contact-arrow" aria-hidden="true">&nearr;</span>
    </a>
    <ul
      class="text-inverse-muted mt-16 flex flex-wrap gap-x-8 gap-y-3"
      aria-label="Social links"
      data-reveal
    >
      {
        site.socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-inverse-text text-sm underline-offset-4 transition-colors hover:underline"
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
