<section
  class="relative mx-auto max-w-6xl overflow-hidden px-6 py-[var(--spacing-section)] md:px-10"
>
  <span
    class="section-intro-watermark"
    aria-hidden="true">Approach</span
  >
  <h2
    class="font-display text-statement relative z-10 leading-[1.05] font-medium tracking-[-0.02em]"
    data-lines
  >
    <span class="block">Structure, then craft.</span>
    <span class="text-accent-warm block font-bold italic">Then ship it.</span>
  </h2>
  <span class="section-intro-rule" data-rule-draw aria-hidden="true"></span>
  <p
    class="text-text-muted relative z-10 mt-8 max-w-xl text-base leading-relaxed"
    data-reveal
    data-word-scrub
  >
    Good products emerge from understanding systems and people equally - not
    from adding features.
  </p>
</section>

<script>
  const rule = document.querySelector('[data-rule-draw]');
  if (rule) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      rule.classList.add('is-drawn');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              rule.classList.add('is-drawn');
              io.disconnect();
            }
          });
        },
        { threshold: 0.6 },
      );
      io.observe(rule);
    }
  }
</script>
