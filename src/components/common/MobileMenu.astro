---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  nav: readonly NavItem[];
  email: string;
}

const { nav, email } = Astro.props;
---

<!-- Behavior (toggle, Escape, focus, scroll lock) lives in lib/animations/ui.ts
     via data attributes, so no per-page script duplication. -->
<div class="md:hidden">
  <button
    type="button"
    class="relative z-50 flex h-10 w-10 items-center justify-center"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-nav"
    data-menu-toggle
  >
    <span class="relative block h-px w-6">
      <span class="menu-line menu-line-top"></span>
      <span class="menu-line menu-line-bottom"></span>
    </span>
  </button>

  <div
    id="mobile-nav"
    class="bg-bg fixed inset-0 z-40 flex flex-col justify-center px-6"
    hidden
    data-menu-overlay
  >
    <nav class="flex flex-col gap-6" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="font-display text-3xl font-medium tracking-tight"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={`mailto:${email}`}
        class="border-text font-display hover:border-accent-warm mt-4 w-fit border px-5 py-3 text-lg font-medium transition-colors"
      >
        Get in touch
      </a>
    </nav>
  </div>
</div>
