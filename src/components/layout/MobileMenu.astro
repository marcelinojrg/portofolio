---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  nav: readonly NavItem[];
  email: string;
}

const { nav, email } = Astro.props;
---

<!-- Behavior (toggle, Escape, focus trap, scroll lock) lives in
     lib/animations/ui.ts via data attributes. Styles live in SiteHeader.css.
     Each item carries an --i index driving its staggered reveal. -->
<div class="mobile-menu">
  <button
    type="button"
    class="menu-toggle"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-nav"
    data-menu-toggle
  >
    <span class="menu-toggle__lines">
      <span class="menu-line menu-line-top"></span>
      <span class="menu-line menu-line-bottom"></span>
    </span>
  </button>

  <div
    id="mobile-nav"
    class="menu-overlay"
    role="dialog"
    aria-modal="true"
    aria-label="Site navigation"
    hidden
    data-menu-overlay
  >
    <nav class="menu-overlay__nav" aria-label="Mobile">
      {
        nav.map((item, i) => (
          <a href={item.href} class="menu-overlay__link" style={`--i: ${i}`}>
            <span class="menu-overlay__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="menu-overlay__contact">
      <p class="eyebrow menu-overlay__contact-label">Get in touch</p>
      <a
        href={`mailto:${email}`}
        class="menu-overlay__email"
        style={`--i: ${nav.length}`}
      >
        {email}
      </a>
    </div>
  </div>
</div>
