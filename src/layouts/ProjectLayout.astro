---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import ProjectCover from '../components/shared/ProjectCover.astro';
import './ProjectLayout.css';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, index, prev, next } = Astro.props;
const { title, category, summary, year, role, status, technologies } =
  project.data;

// Don't ship raw [REPLACE:] text as the meta description.
const safeSummary = summary.startsWith('[REPLACE:')
  ? `${title} - ${category} case study by Marcelino Jorgi.`
  : summary;
---

<BaseLayout title={`${title} - Marcelino Jorgi`} description={safeSummary}>
  <SiteHeader />
  <main id="main">
    <article class="project">
      <header class="project__header">
        <p class="eyebrow project__back" data-hero>
          <a href="/#work" class="project__back-link">&larr; Selected work</a>
        </p>
        <h1 class="project__title" data-hero>
          {title}
        </h1>
        <p class="project__summary" data-hero>
          {summary}
        </p>
      </header>

      <dl class="project__meta" data-reveal>
        <div>
          <dt class="eyebrow">Year</dt>
          <dd class="project-meta__value project-meta__value--num">{year}</dd>
        </div>
        <div>
          <dt class="eyebrow">Category</dt>
          <dd class="project-meta__value">{category}</dd>
        </div>
        <div>
          <dt class="eyebrow">Role</dt>
          <dd class="project-meta__value">{role.join(', ')}</dd>
        </div>
        <div>
          <dt class="eyebrow">Status</dt>
          <dd class="project-meta__value">{status}</dd>
        </div>
      </dl>

      <div class="project__cover-box" data-reveal>
        <ProjectCover {project} {index} />
      </div>

      <div class="prose-case project__body" data-reveal>
        <slot />
      </div>

      {
        technologies.length > 0 && (
          <ul class="project__tech" data-reveal>
            {technologies.map((t) => (
              <li class="project__tech-item">/ {t}</li>
            ))}
          </ul>
        )
      }

      <nav class="project__nav" aria-label="Project navigation">
        {
          prev ? (
            <a href={`/work/${prev.id}`} class="project-nav__link" data-reveal>
              <span class="eyebrow">&larr; Previous</span>
              <span class="project-nav__title">{prev.data.title}</span>
            </a>
          ) : (
            <span aria-hidden="true" />
          )
        }
        {
          next && (
            <a
              href={`/work/${next.id}`}
              class="project-nav__link project-nav__link--next"
              data-reveal
            >
              <span class="eyebrow">Next &rarr;</span>
              <span class="project-nav__title">{next.data.title}</span>
            </a>
          )
        }
      </nav>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>
